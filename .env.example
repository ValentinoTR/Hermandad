# Solo servidor. Nunca uses NEXT_PUBLIC_ para estas variables.
DATABASE_URL=postgresql://hsmi_app.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
HSMI_OWNER_EMAIL=administracion@example.com
# SHA-256 de un token aleatorio de 32 bytes (64 caracteres hex).
HSMI_SETUP_HASH=
